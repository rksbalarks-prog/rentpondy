# Rent_Pondy User (CRA) — copy to .env and fill in real values.
# The real .env is gitignored and must never be committed.
# NOTE: CRA bakes REACT_APP_* in at BUILD time — changes need a rebuild.

# REACT_APP_API_URL=http://localhost:6006/PPC   # local backend (dev)
REACT_APP_API_URL=https://rentpondy.com/PPC/PPC
REACT_APP_AUTH_KEY=your-auth-key
REACT_APP_APP_VERSION=1.0.0

GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# Microsoft Clarity project ID for the PUBLIC user site. This must be a
# SEPARATE project from the admin panel (whose ID lives in
# Rent_Pondy Admin/.env) — otherwise visitor sessions bury the staff ones.
# Empty/absent = Clarity completely off, no script loaded.
REACT_APP_CLARITY_ID=

# AI assistant backend. In dev this is your locally-run PPC server (node server.js).
# REACT_APP_ASSISTANT_URL=http://localhost:5005/api/assistant   # local backend
REACT_APP_ASSISTANT_URL=https://rentpondy.com/PPC/api/assistant
