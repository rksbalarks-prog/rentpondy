# PPC backend — copy to .env and fill in real values.
# The real .env is gitignored and must never be committed.

# ── Server ───────────────────────────────────────────────────
PORT=5005
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/RentPondyPPC
BASE_URL=https://rentpondy.com

# ── SMS Idea (OTP) ───────────────────────────────────────────
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=PONDYY
SENDER_ID=PONDYY
SMS_API_KEY=
DLT_ENTITY_ID=
DLT_TEMPLATE_ID=
DLT_TEMPLATE_ID_ADMIN_LOGIN=

# ── Self-hosted SIM SMS gateway (owner contact-view notify) ──
# Base URL of the sms-gateway backend, reachable FROM this server.
#   dev  : http://localhost:4000
#   prod : VPS IP / tunnel / LAN address of the gateway
SMS_GATEWAY_URL=http://localhost:4000
# API key minted in the gateway with the sms:send scope.
# Create it: POST /api/auth/api-keys { "name":"RentPondy", "scopes":["sms:send"] }
SMS_GATEWAY_API_KEY=

# ── AWS SNS ──────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS.SNS.SMS.SenderID=PONDYY

# ── PayU payment gateway ─────────────────────────────────────
PAYU_KEY=
PAYU_SALT=

# ── Meta WhatsApp Cloud API ──────────────────────────────────
META_API_VERSION=v21.0
META_PHONE_NUMBER_ID=
# Permanent System User access token (Bearer)
META_WHATSAPP_TOKEN=
# Optional separate sender for bulk marketing; blank reuses the two above.
# META_BULK_PHONE_NUMBER_ID=
# META_BULK_WHATSAPP_TOKEN=

# ── AI assistant (voice + chat) ──────────────────────────────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
ASSISTANT_ENABLED=true
ASSISTANT_PROVIDER=openai
ASSISTANT_MAX_TOOL_LOOPS=6
ASSISTANT_HISTORY_TURNS=12
ASSISTANT_DAILY_TOKEN_BUDGET=200000
# HMAC secret for signing short-lived assistant session tokens
ASSISTANT_JWT_SECRET=
# Base used by read-tools for LIVE property data (production REST API)
ASSISTANT_API_BASE=https://rentpondy.com/PPC/PPC
# Require a verified OTP login before minting a token. Off for dev.
ASSISTANT_REQUIRE_VERIFIED_LOGIN=false

# ── Data Added e-mail report (PPC/DataAddedMail) ─────────────
DATA_ADDED_REPORT_ENABLED=1
DATA_ADDED_REPORT_TO=
DATA_ADDED_REPORT_CC=
DATA_ADDED_REPORT_CRON=0 9 1 * *
DATA_ADDED_REPORT_TZ=Asia/Kolkata
DATA_ADDED_REPORT_BASE=ALL
DATA_ADDED_REPORT_HIDE_DELETED=0
DATA_ADDED_REPORT_TOKEN=

# ── SMTP (report mailers) ────────────────────────────────────
# SMTP_PASS is a Gmail App Password (16 chars, no spaces) — NOT the
# account password. Until it is filled the report layer stays asleep.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Rent Pondy Reports <you@example.com>
