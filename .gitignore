# ─────────────────────────────────────────────────────────────
#  RentPondy — repository ignore rules
#  Covers: PPC (backend), Rent_Pondy Admin, Rent_Pondy User,
#          rentpondy_flutter
# ─────────────────────────────────────────────────────────────

# ── Secrets & credentials — NEVER commit ─────────────────────
.env
.env.*
!.env.example
*.pem
*.key
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist
*.keystore
*.jks
key.properties

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
jspm_packages/

# ── Build output (web) ───────────────────────────────────────
build/
dist/
out/
.next/
.parcel-cache/
*.tsbuildinfo

# ── Flutter / Dart ───────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
*.apk
*.aab
*.aar
*.ipa
*.app.dSYM.zip

# ── Android / Gradle ─────────────────────────────────────────
.gradle/
local.properties
captures/
*.iml

# ── iOS / macOS ──────────────────────────────────────────────
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/App.framework
ios/Flutter/ephemeral/
Podfile.lock
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# ── Archives & backups (too large for git) ───────────────────
# Local snapshot of the separate PondyProperties project + its uploaded
# property media (~749 MB). That project has its own repo; the media also
# lives on the VPS. Kept on disk, out of git.
Rent_Pondy Admin/backup/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.bak
*.dump

# ── Logs & crash dumps ───────────────────────────────────────
*.log
hs_err_pid*.log
replay_pid*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# ── Caches & coverage ────────────────────────────────────────
.cache/
.eslintcache
coverage/
.nyc_output/
*.tmp
tmp/
temp/

# ── Editor / OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
