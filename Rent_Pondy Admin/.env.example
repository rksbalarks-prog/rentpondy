# Rent_Pondy Admin (CRA) — copy to .env and fill in real values.
# The real .env is gitignored and must never be committed.
# NOTE: CRA bakes REACT_APP_* in at BUILD time — changes need a rebuild.

GENERATE_SOURCEMAP=false
REACT_APP_API_URL=https://rentpondy.com/PPC/PPC
REACT_APP_MEDIA_URL=https://rentpondy.com/PPC
REACT_APP_AUTH_KEY=your-auth-key
REACT_APP_APP_VERSION=1.0.0

# Shared secret for the admin push endpoints — must equal PUSH_ADMIN_KEY
# in the PPC backend .env. Sent as the x-push-key header from the Push screen.
REACT_APP_PUSH_ADMIN_KEY=

# Microsoft Clarity project ID (clarity.microsoft.com → Settings → Overview).
# Must be a SEPARATE project from the public user site.
# Empty/absent = Clarity completely off, no script loaded.
REACT_APP_CLARITY_ID=

# AI Assistant backend (owner leads). In dev this is your locally-run PPC server.
# Leave unset in production — the AI Assistant Leads screen falls back to
# REACT_APP_API_URL (the assistant is mounted inside the same PPC backend).
# REACT_APP_ASSISTANT_API=http://localhost:5005/PPC
